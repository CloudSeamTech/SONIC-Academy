{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node tools/prepare-bicep-runtime.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && npm --prefix local-companion test",
    "companion:install": "npm --prefix local-companion install",
    "companion:start": "npm --prefix local-companion start",
    "screenshots:coverage": "node --experimental-strip-types tools/screenshot-coverage.mjs",
    "screenshots:check": "node --experimental-strip-types tools/screenshot-coverage.mjs --require-complete",
    "screenshots:core-check": "node --experimental-strip-types --test tests/core-guides.test.mjs",
    "pictures:generate": "node --experimental-strip-types tools/generate-step-pictures.mjs",
    "pictures:check": "node --experimental-strip-types --test tests/step-pictures.test.mjs",
    "nessus:captures": "node tools/nessus-capture-inventory.mjs",
    "teaching:review": "node tools/teaching-review.mjs",
    "screenshots:interfaces": "node tools/audit-interface-screenshots.mjs",
    "screenshots:interfaces-check": "node tools/audit-interface-screenshots.mjs --require-references",
    "screenshots:targets-check": "node tools/audit-interface-screenshots.mjs --require-complete",
    "db:generate": "drizzle-kit generate",
    "test:academy-api": "node tools/check-academy-api.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
